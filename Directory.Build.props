<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NeutralLanguage>en</NeutralLanguage>

    <!-- Symbols inside the assembly, so a published folder has no loose pdbs. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <Product>Recode</Product>
    <Authors>Bertram Bech Larsen</Authors>
    <Company>Bertram Bech Larsen</Company>
    <Copyright>Copyright (c) 2026 Bertram Bech Larsen</Copyright>
    <RepositoryUrl>https://github.com/Bertrram/recode</RepositoryUrl>
  </PropertyGroup>

  <!--
    Two architectures. Native dependencies are supplied per architecture by
    tools/build-natives.ps1 and are never committed to the repository.
  -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>


</Project>
