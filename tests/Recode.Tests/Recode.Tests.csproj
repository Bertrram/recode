<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Recode.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Recode.Core\Recode.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestImages\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The end to end tests need the bundled libraries, the same ones the
    application loads. Unit tests do not: everything that touches a native
    library sits behind an interface and is exercised with a stub.
  -->
  <PropertyGroup>
    <NativeArch Condition="'$(PROCESSOR_ARCHITECTURE)' == 'ARM64'">arm64</NativeArch>
    <NativeArch Condition="'$(NativeArch)' == ''">x64</NativeArch>
    <NativeDirectory>$(MSBuildThisFileDirectory)..\..\native\$(NativeArch)</NativeDirectory>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NativeDirectory)\*.dll"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
