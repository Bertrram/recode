<Window x:Class="Recode.App.Ui.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recode"
        Width="440" SizeToContent="Height"
        MaxHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText"
                   Grid.Row="0"
                   FontSize="15"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource RecodeText}" />

        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Padding="12,10,12,10"
                Background="{DynamicResource RecodeCardBackground}"
                BorderBrush="{DynamicResource RecodeBorder}"
                BorderThickness="1"
                CornerRadius="6">
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DetailList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Margin="0,2,0,2"
                                       Foreground="{DynamicResource RecodeText}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button x:Name="CloseButton"
                Grid.Row="2"
                Content="Close"
                Margin="0,14,0,0"
                Padding="20,5,20,5"
                MinWidth="88"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Click="OnClose" />
    </Grid>
</Window>
