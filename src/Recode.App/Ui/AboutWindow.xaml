<Window x:Class="Recode.App.Ui.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recode"
        Width="460" Height="420"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource RecodeSecondaryText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource RecodeText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Mark" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="{DynamicResource RecodeOk}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Available}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource RecodeProblem}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Recode"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource RecodeText}" />
            <TextBlock x:Name="SubtitleText"
                       FontSize="12"
                       Margin="0,2,0,0"
                       Foreground="{DynamicResource RecodeSecondaryText}" />
        </StackPanel>

        <!-- Column headings -->
        <Grid Grid.Row="1" Margin="12,0,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Format" Style="{StaticResource ColumnHeader}" />
            <TextBlock Grid.Column="1" Text="Read" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Write" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="Backend" Style="{StaticResource ColumnHeader}" Margin="8,0,0,0" />
        </Grid>

        <!-- Format table -->
        <Border Grid.Row="2"
                Background="{DynamicResource RecodeCardBackground}"
                BorderBrush="{DynamicResource RecodeBorder}"
                BorderThickness="1"
                CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,4">
                <ItemsControl x:Name="FormatList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,3,12,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Format}" Style="{StaticResource Cell}" />
                                <TextBlock Grid.Column="1" Text="{Binding Read}" Style="{StaticResource Mark}" />
                                <TextBlock Grid.Column="2" Text="{Binding Write}" Style="{StaticResource Mark}" />
                                <TextBlock Grid.Column="3" Text="{Binding Backend}" Style="{StaticResource Cell}"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource RecodeSecondaryText}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Shown only when a bundled library is missing -->
        <Border x:Name="ProblemPanel"
                Grid.Row="3"
                Visibility="Collapsed"
                Margin="0,12,0,0"
                Padding="12,10,12,10"
                Background="{DynamicResource RecodeCardBackground}"
                BorderBrush="{DynamicResource RecodeProblem}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Missing files"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{DynamicResource RecodeProblem}" />
                <ItemsControl x:Name="ProblemList" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Margin="0,1,0,1"
                                       Foreground="{DynamicResource RecodeText}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="VersionText"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource RecodeSecondaryText}" />
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11">
                <Hyperlink x:Name="RepositoryLink"
                           RequestNavigate="OnRequestNavigate"
                           Foreground="{DynamicResource RecodeLink}"
                           TextDecorations="None">
                    <Run x:Name="RepositoryLinkText" />
                </Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
